From: Wint <Wint-Tele100gramm@users.noreply.github.com>
Subject: [PATCH] sumavision-q5: translate boot and error messages to Russian

Distro boot scan, file loading, MMC read/write, device tree, kernel
start, environment import, partition and unknown command messages.
---
diff --git a/arch/arm/lib/image.c b/arch/arm/lib/image.c
index 2268661d..ea932566 100644
--- a/arch/arm/lib/image.c
+++ b/arch/arm/lib/image.c
@@ -40,7 +40,7 @@ int booti_setup(ulong image, ulong *relocated_addr, ulong *size,
 	ih = (struct Image_header *)map_sysmem(image, 0);
 
 	if (ih->magic != le32_to_cpu(LINUX_ARM64_IMAGE_MAGIC)) {
-		puts("Bad Linux ARM64 Image magic!\n");
+		puts("Неверная сигнатура образа ядра Linux ARM64!\n");
 		return 1;
 	}
 
diff --git a/arch/arm/lib/reset.c b/arch/arm/lib/reset.c
index c9796a44..7f2704b2 100644
--- a/arch/arm/lib/reset.c
+++ b/arch/arm/lib/reset.c
@@ -32,7 +32,7 @@ __weak void reset_misc(void)
 
 int do_reset(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
 {
-	puts ("resetting ...\n");
+	puts ("перезагрузка ...\n");
 	flush();
 
 	disable_interrupts();
diff --git a/boot/bootm.c b/boot/bootm.c
index 3bce8586..c68d83f7 100644
--- a/boot/bootm.c
+++ b/boot/bootm.c
@@ -85,7 +85,7 @@ static struct legacy_img_hdr *image_get_kernel(ulong img_addr, int verify)
 	image_print_contents(hdr);
 
 	if (verify) {
-		puts("   Verifying Checksum ... ");
+		puts("   Проверка контрольной суммы ... ");
 		if (!image_check_dcrc(hdr)) {
 			printf("Bad Data CRC\n");
 			bootstage_error(BOOTSTAGE_ID_CHECK_CHECKSUM);
@@ -317,7 +317,7 @@ static int bootm_find_os(const char *cmd_name, const char *addr_fit)
 			      &images.os.image_len, &os_hdr);
 	if (ret) {
 		if (ret == -EPROTOTYPE)
-			printf("Wrong Image Type for %s command\n", cmd_name);
+			printf("Неверный тип образа для команды %s\n", cmd_name);
 
 		printf("ERROR %dE: can't get kernel image!\n", ret);
 		return 1;
@@ -733,7 +733,7 @@ static int bootm_load_os(struct bootm_headers *images, int boot_progress)
 
 		/* Handle BOOTM_STATE_LOADOS */
 		if (relocated_addr != load) {
-			printf("Moving Image from 0x%lx to 0x%lx, end=0x%lx\n",
+			printf("Перемещение ядра из 0x%lx в 0x%lx, конец 0x%lx\n",
 			       load, relocated_addr,
 			       relocated_addr + image_size);
 			memmove((void *)relocated_addr, load_buf, image_size);
@@ -1244,7 +1244,7 @@ void __weak switch_to_non_secure_mode(void)
 
 void bootm_final(int flag)
 {
-	printf("\nStarting kernel ...%s\n\n",
+	printf("\nЗапуск ядра ...%s\n\n",
 	       (flag & BOOTM_STATE_OS_FAKE_GO) ?
 	       " (fake run for tracing)" : "");
 
