diff --git a/cmd/fdt.c b/cmd/fdt.c
index 7e2abf96..be92eb1c 100644
--- a/cmd/fdt.c
+++ b/cmd/fdt.c
@@ -47,7 +47,7 @@ static void set_working_fdt_addr_quiet(ulong addr)
 
