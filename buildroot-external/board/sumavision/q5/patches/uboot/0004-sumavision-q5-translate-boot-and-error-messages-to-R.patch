diff --git a/cmd/mmc.c b/cmd/mmc.c
index 6a12d683..752eb4d2 100644
--- a/cmd/mmc.c
+++ b/cmd/mmc.c
@@ -366,11 +366,11 @@ static int do_mmc_read(struct cmd_tbl *cmdtp, int flag,
 	if (!mmc)
 		return CMD_RET_FAILURE;
 
-	printf("MMC read: dev # %d, block # %d, count %d ... ",
+	printf("MMC: чтение, устройство %d, блок %d, блоков %d ... ",
 	       curr_device, blk, cnt);
 
 	n = blk_dread(mmc_get_blk_desc(mmc), blk, cnt, ptr);
-	printf("%d blocks read: %s\n", n, (n == cnt) ? "OK" : "ERROR");
+	printf("прочитано %d: %s\n", n, (n == cnt) ? "OK" : "ОШИБКА");
 	unmap_sysmem(ptr);
 
 	return (n == cnt) ? CMD_RET_SUCCESS : CMD_RET_FAILURE;
@@ -460,7 +460,7 @@ static int do_mmc_write(struct cmd_tbl *cmdtp, int flag,
 	if (!mmc)
 		return CMD_RET_FAILURE;
 
-	printf("MMC write: dev # %d, block # %d, count %d ... ",
+	printf("MMC: запись, устройство %d, блок %d, блоков %d ... ",
 	       curr_device, blk, cnt);
 
 	if (mmc_getwp(mmc) == 1) {
@@ -468,7 +468,7 @@ static int do_mmc_write(struct cmd_tbl *cmdtp, int flag,
 		return CMD_RET_FAILURE;
 	}
 	n = blk_dwrite(mmc_get_blk_desc(mmc), blk, cnt, ptr);
-	printf("%d blocks written: %s\n", n, (n == cnt) ? "OK" : "ERROR");
+	printf("записано %d: %s\n", n, (n == cnt) ? "OK" : "ОШИБКА");
 	unmap_sysmem(ptr);
 
 	return (n == cnt) ? CMD_RET_SUCCESS : CMD_RET_FAILURE;
