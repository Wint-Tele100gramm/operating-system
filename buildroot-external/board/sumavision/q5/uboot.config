# Sumavision Q5 U-Boot (sumavision-q5_defconfig, v2026.10) on top of
# bootloader/uboot.config.
CONFIG_DOS_PARTITION=y
CONFIG_DISPLAY_BOARDINFO=y
# Autoboot can still be stopped with Ctrl+C on the UART (AUTOBOOT_KEYED)
CONFIG_BOOTDELAY=1
# Not needed for HAOS, avoids the OpenSSL host dependency of mkimage
# CONFIG_FIT_SIGNATURE is not set
